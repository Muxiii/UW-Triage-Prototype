# Local: npm run dev:local (loads this file). Render/Vercel use dashboard env vars + npm start / npm run dev.
AI_PROVIDER=kimi
AI_API_KEY=your-api-key-here
# AI_MODEL=moonshot-v1-auto

# Supabase (optional — omit to keep using data/db.json)
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Render only (when Node serves HTML): browser API prefix
# PUBLIC_API_BASE=https://your-api.onrender.com/api

# Vercel only: set in Project → Settings → Environment Variables
# VITE_API_BASE=https://your-api.onrender.com/api
